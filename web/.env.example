APP_NAME=MatchIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Moscow

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=matchiq
DB_USERNAME=matchiq
DB_PASSWORD=matchiq

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@matchiq.local"
MAIL_FROM_NAME="${APP_NAME}"

# OAuth: Яндекс ID (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI="${APP_URL}/auth/yandex/callback"

# OAuth: VK ID (https://id.vk.com/about/business/go/docs)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI="${APP_URL}/auth/vk/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=matchiq
RABBITMQ_PASSWORD=matchiq
RABBITMQ_VHOST=/

# Плановый ingest (scheduler, config/ingest.php). Интервалы в минутах, 0 — выключить задачу.
INGEST_SCHEDULE_ENABLED=true
# Override: slug'и через запятую; пусто — соревнования с competitions.ingest_enabled=true и внешним id SStats
INGEST_COMPETITIONS=
INGEST_FIXTURES_EVERY_MINUTES=10
INGEST_FIXTURES_DAYS_BACK=2
INGEST_FIXTURES_DAYS_FORWARD=2
INGEST_FIXTURES_FULL_DAILY_AT=03:30
INGEST_DETAILS_MISSING_EVERY_MINUTES=15
INGEST_DETAILS_MISSING_LIMIT=10
INGEST_DETAILS_RECENT_EVERY_MINUTES=60
INGEST_DETAILS_RECENT_DAYS_BACK=1
INGEST_DETAILS_RECENT_LIMIT=10
INGEST_DETAILS_LIVE_EVERY_MINUTES=15
INGEST_DETAILS_LIVE_OFFSET_MINUTES=5
INGEST_DETAILS_LIVE_LIMIT=20
INGEST_DETAILS_LIVE_MAX_AGE_HOURS=6
INGEST_CATALOG_DAILY_AT=04:00
# Override фильтров sync_catalog; пусто — лиги включённых соревнований (ingest_enabled)
INGEST_CATALOG_COUNTRY=
INGEST_CATALOG_LEAGUE=
INGEST_STRUCTURE_DAILY_AT=04:10
INGEST_SQUADS_DAILY_AT=04:20
# Override slug'ов для составов; пусто — включённые соревнования (ingest_enabled)
INGEST_SQUADS_COMPETITIONS=
INGEST_REAP_EVERY_MINUTES=10
INGEST_STUCK_AFTER_MINUTES=60
INGEST_BATCH_ORDER_WAIT_SECONDS=30
