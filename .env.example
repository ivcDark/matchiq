# Copy to .env at repo root for docker compose variable substitution.
# Do not commit real secrets.

APP_PORT=8000
# Host port published for Vite (container stays on 5173). If bind fails
# ("port is already allocated"), set e.g. VITE_HOST_PORT=5174.
VITE_HOST_PORT=5173
COLLECTOR_PORT=8081
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Часовой пояс приложения: schedule (03:30/04:00/04:10) и окна дат ingest — по Москве
APP_TIMEZONE=Europe/Moscow

# Generate with: cd web && php artisan key:generate --show
APP_KEY=

POSTGRES_DB=matchiq
POSTGRES_USER=matchiq
POSTGRES_PASSWORD=matchiq

# Optional Redis password (leave empty for local)
REDIS_PASSWORD=

# RabbitMQ (ingest: Laravel <-> Go collector). Management UI: http://localhost:15672
RABBITMQ_USER=matchiq
RABBITMQ_PASSWORD=matchiq
RABBITMQ_VHOST=/
# Collector URL inside compose; при нестандартных user/pass/vhost задайте вручную
# (vhost "/" — пустой путь или "/", иной vhost — amqp://user:pass@rabbitmq:5672/my_vhost)
COLLECTOR_RABBITMQ_URL=amqp://matchiq:matchiq@rabbitmq:5672/

# SStats.net API key — только collector, в БД и в сообщения не попадает
SSTATS_API_KEY=
COLLECTOR_PREFETCH=2
